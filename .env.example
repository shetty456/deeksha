# Supabase — get from supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-secret-key

# Deepgram — get from console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key

# LLM — Groq at console.groq.com
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b

# Razorpay — get from dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-id
